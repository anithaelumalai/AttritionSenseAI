# AttritionSense AI - Environment Configuration Example

# SMTP Email Notification Settings (Optional - for HR Feedback alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_hr_notifications@example.com
SMTP_PASSWORD=your_app_password_here
HR_EMAIL=hr_director@example.com

# Google Gemini API Key (Optional - for enhanced BuddyBot generative chat)
GEMINI_API_KEY=your_gemini_api_key_here
